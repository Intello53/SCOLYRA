{
  "name": "@scolyra/db",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:demo": "dotenv -e ../../.env -- tsx prisma/seed-demo.ts",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "prisma": "^5.19.1",
    "tsx": "^4.19.0",
    "dotenv-cli": "^7.4.2",
    "typescript": "^5.6.2"
  }
}
