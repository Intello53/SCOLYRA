# =========================================
# SCOLYRA — Variables d'environnement (exemple)
# Copier ce fichier en .env puis remplir les valeurs.
# NE JAMAIS committer le fichier .env réel.
# =========================================

# --- Base de données ---
DATABASE_URL="postgresql://scolyra:scolyra@localhost:5432/scolyra?schema=public"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- Authentification ---
AUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# --- IA ---
# "mock" fonctionne sans aucune clé externe (voir packages/ai)
AI_PROVIDER="mock"
AI_API_KEY=""

# --- Stripe (TEST uniquement en développement) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Resend (emails) ---
# Laisser vide en dev : les emails sont alors loggés en console au lieu d'être envoyés
RESEND_API_KEY=""
RESEND_FROM="SCOLYRA <no-reply@scolyra.app>"

# --- Stockage (MinIO en dev, S3-compatible en prod) ---
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="scolyra"
MINIO_SECRET_KEY="scolyra12345"
MINIO_BUCKET="scolyra-dev"
STORAGE_USE_SSL="false"

# --- Divers ---
NODE_ENV="development"
