{
  "name": "scolyra",
  "private": true,
  "version": "0.1.0",
  "description": "SCOLYRA — copilote pédagogique et d'orientation pour élèves et étudiants",
  "scripts": {
    "dev": "pnpm --filter @scolyra/web dev",
    "build": "pnpm --filter @scolyra/web build",
    "start": "pnpm --filter @scolyra/web start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @scolyra/web test:e2e",
    "db:generate": "pnpm --filter @scolyra/db generate",
    "db:migrate": "pnpm --filter @scolyra/db migrate",
    "db:seed": "pnpm --filter @scolyra/db seed",
    "seed:demo": "pnpm --filter @scolyra/db seed:demo"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
