# =========================================
# SCOLYRA — Variables d'environnement (exemple)
# Copier ce fichier en .env puis remplir les valeurs.
# NE JAMAIS committer le fichier .env réel.
# =========================================

# --- Base de données ---
DATABASE_URL="postgresql://scolyra:scolyra@localhost:5432/scolyra?schema=public"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- Authentification (next-auth v4) ---
NEXTAUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- IA ---
# "mock" fonctionne sans aucune clé externe (voir packages/ai) — c'est
# la valeur par défaut, aucune configuration requise pour tester l'app.
# Pour un vrai raisonnement IA (coach, agents), passer à "anthropic" et
# renseigner AI_API_KEY (voir docs/AI.md pour la procédure complète).
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL_FAST="claude-haiku-4-5-20251001"
AI_MODEL_POWERFUL="claude-sonnet-4-5"

# --- Stripe (TEST uniquement en développement) ---
# --- Stripe (TEST uniquement en développement) ---
# Laisser vide = mode démo (bascule Premium instantanée sans paiement,
# voir /api/subscription/upgrade). Renseigner les 4 valeurs ci-dessous
# active le vrai paiement Stripe Checkout — voir docs/PAYMENTS.md pour
# la procédure complète, étape par étape.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID_PREMIUM=""

# --- Resend (emails) ---
# Laisser vide en dev : les emails sont alors loggés en console au lieu d'être envoyés
RESEND_API_KEY=""
RESEND_FROM="SCOLYRA <no-reply@scolyra.app>"

# --- Stockage (MinIO en dev, S3-compatible en prod) ---
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="scolyra"
MINIO_SECRET_KEY="scolyra12345"
MINIO_BUCKET="scolyra-dev"
STORAGE_USE_SSL="false"

# --- Divers ---
NODE_ENV="development"
